OPENAI_API_KEY=
# Optional. Lets /model and /provider switch to OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default model as provider:model, for example openai:gpt-4.1-mini or
# openrouter:anthropic/claude-sonnet-4.5. Change it per chat with /model.
AGENT_MODEL=openai:gpt-4.1-mini

# Startup reasoning effort for GPT-5 and GPT-6.
# auto, none, minimal, low, medium, high, xhigh, or max.
# auto picks from the message. xhigh is a long thinking spree. max is longer.
# /reasoning in the chat overrides this until the process stops.
AGENT_REASONING_EFFORT=xhigh

# How many model and tool steps one reply can take before it stops.
AGENT_STEP_LIMIT=100

# Directory list_files, search_files, and read_file can see.
# Defaults to the directory you start the bot in.
# AGENT_FILES_ROOT=

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Optional. Comma-separated Telegram user ids. Leave empty to allow anyone.
# Your id is printed in the bot log, or you can ask @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# Search engines for web_search, tried in order. Supported: google, bing, tavily.
# Google and Bing are scraped with a headless browser and sometimes block it.
WEB_SEARCH_ENGINES=google,bing,tavily
# Optional fallback for search and for pages the browser can't read.
# Free key (1,000 credits a month, no card): https://app.tavily.com
TAVILY_API_KEY=
# Set to 0 to watch the browser work.
WEB_HEADLESS=1

# Where each user's memory database is stored. Default: data/memory
# MEMORY_DIR=

# Optional. Lambda functions whose tools the agent can call, as comma-separated
# names or ARNs. Needs boto3 (uv sync --extra lambda) and AWS credentials.
# LAMBDA_TOOL_FUNCTIONS=
# Seconds to wait for a Lambda tool to answer. Default: 60
# LAMBDA_TOOL_TIMEOUT=
